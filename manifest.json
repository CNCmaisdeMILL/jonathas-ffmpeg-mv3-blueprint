{
  "manifest_version": 3,
  "name": "Millow FFmpeg Pro",
  "version": "1.0.0",
  "description": "Conversor nativo de áudio para WhatsApp Web.",
  "permissions": [
    "offscreen",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}